{
 "schema_version": 1,
 "benchmark_id": "chimera-local",
 "benchmark_version": "1.0.0",
 "manifest_id": "mb-v1-pilot",
 "split": "development",
 "description": "Pilot: S-SLOW x I-PLAIN x slow_ms=2100 only, 2 trials + 1 warmup per arm.",
 "slow_band_ms": {
  "max_ms": 4000,
  "min_ms": 500
 },
 "config": {
  "action_timeout_ms": 5000,
  "episode_timeout_seconds": 60.0,
  "policy": {
   "base_delay_seconds": 0.05,
   "max_attempts": 2,
   "max_delay_seconds": 0.2,
   "max_total_seconds": 5.0
  },
  "trials_per_cell": 2,
  "warmup_episodes": 1
 },
 "scenarios": [
  {
   "description": "Transient fault: the controls start disabled and are re-enabled after the slow delay.",
   "expected_outcome": "succeeded",
   "fault_variants": [
    {
     "disabled": false,
     "slow_ms": 2100
    }
   ],
   "id": "S-SLOW",
   "inputs": [
    {
     "expected_stored_name": "Benchmark Project",
     "id": "I-PLAIN",
     "project_name": "Benchmark Project"
    }
   ],
   "postconditions": [
    {
     "description": "The confirmation element is visible.",
     "id": "P1",
     "kind": "confirmation_visible",
     "verified_by": "independent_verifier"
    },
    {
     "description": "Exactly one project-list entry whose textContent equals the expected stored name (trimmed).",
     "id": "P2",
     "kind": "exact_stored_name_in_list",
     "verified_by": "independent_verifier"
    },
    {
     "description": "The project list contains exactly one entry.",
     "id": "P3",
     "kind": "no_unexpected_entries",
     "verified_by": "independent_verifier"
    }
   ],
   "preconditions": [
    {
     "description": "The project list is empty before the agent's click (harness-only check at navigation time).",
     "id": "P4",
     "kind": "list_empty_before_click",
     "verified_by": "independent_verifier"
    }
   ],
   "timeout_seconds": 30.0
  }
 ]
}
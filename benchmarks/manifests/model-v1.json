  "description": "Baseline B manifest. The same create-project task and the same P1-P3 postconditions as dev-v1, sized for a model-driven agent (6 cells x 5 trials = 30 episodes plus 1 warm-up). Longer timeouts reflect model latency, not a larger per-action budget: Baseline B acts under the same 5 s per-action timeout as Chimera.",
  "manifest_id": "model-v1",
  "scenarios": [
    {
      "description": "No fault. The controls are enabled on load.",
      "expected_outcome": "succeeded",
      "fault_variants": [
        {
          "disabled": false,
          "slow_ms": 0
        }
      ],
      "id": "S-NORM",
      "inputs": [
        {
          "expected_stored_name": "Benchmark Project",

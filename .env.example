# Chimera — environment configuration template.
#
# Copy to `.env` (gitignored; never commit it) and fill in your own values:
#
#     cp .env.example .env
#
# Only the Muse Spark features read these variables: Baseline B (the
# model-driven browser agent run through the benchmark harness) and the
# Workflow Studio planner. Everything else — the deterministic drivers,
# the independent verifier, the action observer, the Workbench, the site
# and the Research Console — needs NO environment variables and runs with
# no `.env` present. No model is ever used to verify a run.
#
# Rules (SRS NFR-013, NFR-025):
#   - Placeholder values only in this file — never a real credential.
#   - The key is read from the environment / `.env` only; it must never be
#     written to traces, snapshots, action logs, reports or the database.

# Meta Model API key (sent as `Authorization: Bearer <key>`).
MODEL_API_KEY=replace-with-your-meta-model-api-key

# OpenAI-compatible Meta Model API base URL.
MODEL_API_BASE=https://api.meta.ai/v1

# Model used by Baseline B and the Studio planner.
CHIMERA_MODEL=muse-spark-1.3
